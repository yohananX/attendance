# Grace House School Attendance — environment variables
#
# Copy to .env.local for local development and fill in real values.
# NEVER commit .env.local or any file containing real credentials.
# In production these are set in Vercel → Project → Settings → Environment
# Variables. Credentials and secrets are server-only: never prefix them with
# NEXT_PUBLIC_ or send them to the browser. ATTENDANCE_DATASET_ID is an opaque,
# non-secret identity returned to clients to scope their local attendance.

# Supabase project URL (server-side only — the browser never talks to
# Supabase directly; RLS has no policies, only the service role is used)
SUPABASE_URL=

# Supabase service-role key (server-only; keep server-only in Vercel, too)
SUPABASE_SERVICE_ROLE_KEY=

# Unique attendance database identity. Use a different value for each database
# and change it whenever the attendance database is replaced or cleared.
# Local development defaults to "development" when this is blank.
ATTENDANCE_DATASET_ID=

# Secret used to sign session cookies/tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Separate operator secret for the protected /api/health endpoint.
# Generate with the same command as SESSION_SECRET.
HEALTH_CHECK_SECRET=

# Staff PIN (minimum 6 digits). Verified on the server only, constant-time.
STAFF_PIN=

# School name shown in the app and parent messages (public configuration,
# not a secret)
SCHOOL_NAME=Grace House School
